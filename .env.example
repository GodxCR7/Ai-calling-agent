# ================================================================
# FYDO AI CALLING AGENT - Environment Variables
# ================================================================
# HOW TO USE:
# 1. Rename this file to .env
# 2. Fill in your own keys OR use the keys shared via WhatsApp
# 3. I have shared my Personal Google Sheet on WhatsApp, you can add your
#    (NAME, PHONE NUMBER, keep STATUS empty) and test the calls.
# 4. You can also create your own Google Sheet and share the credentials
#    file with me to add it in the project.
#
#   FOR SAFETY - FOLLOWING FILES ARE NOT SHARED ON GITHUB:
# - .env             (contains all secret API keys)
# - credentials.json (contains my Google Cloud Console service account)
#
#  TO GET THESE FILES:
# - Ask Pratik on WhatsApp - he will share them directly to whatsapp personally for security reasons.
# - Place both files in the project root folder before running
# ================================================================

# VAPI (shared via WhatsApp)
VAPI_API_KEY=your_vapi_key_here
VAPI_PHONE_NUMBER=+17722934529

# GROQ - Get free key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# TWILIO (shared via WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_number

# DEEPGRAM (shared via WhatsApp)
DEEPGRAM_API_KEY=your_deepgram_key

# OLLAMA - leave as is
OLLAMA_MODEL=phi3

# GOOGLE SHEETS - credentials.json shared via WhatsApp
# Place credentials.json in the project root folder
GOOGLE_CREDENTIALS_FILE=credentials.json